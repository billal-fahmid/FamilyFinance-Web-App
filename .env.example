# ── FamFinance environment ───────────────────────────────────────────────────
# Copy to .env (or .env.local) and fill in. Restart `next dev` after changes —
# Next.js only reads env files at startup.

# Supabase project URL — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Publishable / anon key — Project Settings → API. Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# Service role / secret key — Project Settings → API. SERVER ONLY.
# Used by app/api/auth/signup, app/api/family/create, and the weekly-report
# cron route. Never prefix with NEXT_PUBLIC_ and never expose it to the client.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Public site URL — used for auth + invite links. In production set this to the
# deployed origin, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Invite emails (optional) ────────────────────────────────────────────────
# If both are set, "Invite Family Member" also emails the join link via Resend
# (https://resend.com). Without them, invites still work via the copy /
# WhatsApp / mailto buttons. INVITE_FROM_EMAIL must be on a Resend-verified
# domain, e.g. "Family Finance <invites@yourdomain.com>".
RESEND_API_KEY=
INVITE_FROM_EMAIL=

# ── Weekly income/expense report email (optional) ──────────────────────────
# Reuses RESEND_API_KEY + INVITE_FROM_EMAIL above. CRON_SECRET protects
# /api/cron/weekly-report from being triggered by anyone else — Vercel sends
# it automatically as `Authorization: Bearer <value>` for Cron Job requests
# once both this var and vercel.json's cron entry are set. Generate any long
# random string, e.g. `openssl rand -hex 32`. See docs/DEPLOYMENT.md.
CRON_SECRET=
